# TaskForce 环境变量模板:复制为 .env 后填入真实值(.env 已在 .gitignore 中,绝不入库)
# 说明:全部走 OpenAI 兼容协议;也可不填这里,改用运行后的「设置 → 模型」页填写(存 .taskforce/,同样不入库)

# ── 主模型(LLM):对话 / 路由 / 子智能体共用 ─────────────────────
# base_url 填服务根地址(多数平台以 /v1 结尾)
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=your-chat-model-name
# 计费单价(元/百万 token),仅用于 /stats 的用量估算,可留 0
LLM_INPUT_PRICE_PER_M=0.0
LLM_OUTPUT_PRICE_PER_M=0.0

# ── Embedding(向量检索):知识库入库与召回用 ───────────────────
EMBEDDING_BASE_URL=https://your-embedding-endpoint.example.com/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model-name

# ── 数据库:PostgreSQL + pgvector(默认对应 docker-compose.yml 的 5433)──
DATABASE_URL=postgresql://taskforce:taskforce@127.0.0.1:5433/taskforce

# ── 执行沙箱:采用腾讯云提供的沙箱服务，用于执行代码────────
#Tencent Sandbox
E2B_DOMAIN=
E2B_API_KEY=

# ── 联网调研:AnySearch(留空走匿名调用,按 IP 限流)──────────────
ANYSEARCH_API_KEY=

# ── 知识库(rag_v01):向量化与 Milvus 连接 ──────────────────────
# 与上面的 Embedding 段是**两套**,可以填不同的服务:rag_v01 只认 RAG2_ 前缀的
# **进程环境变量**,不读 .env 解析器(见 src/rag_v01/config.py 头部说明)。
# 所以命令行入口要用 `uv run --env-file .env ...`;桌面壳会自动把整份 .env 载入进程环境。
# 变量名 = RAG2_ + Config 字段名大写(机械映射,新增变量只改 config.py + 其 01 篇变量表)。
RAG2_EMBED_MODE=api
RAG2_EMBED_MODEL=qwen3-vl-embedding
RAG2_EMBED_API_BASE=https://dashscope.aliyuncs.com/api/v1
RAG2_EMBED_API_KEY=your-embedding-api-key
RAG2_MILVUS_URI=http://localhost:19530
# 其余 RAG2_* 都有合理默认值,按需再打开:
# RAG2_DO_OCR=false                # 扫描件才开;文本型 pdf 开了只会更慢
# RAG2_IMAGE_DIR=data/rag2_images  # 抽取图片落盘目录(桌面壳会指到用户数据目录,不必在此设)
# RAG2_EMBED_DIM=1024
# RAG2_RETRIEVE_TOP_K=5

# ── 日志级别:DEBUG / INFO / WARNING / ERROR ───────────────────
LOG_LEVEL=INFO
